# applepie-ui environment contract.
# Every EXPO_PUBLIC_* var below is read at startup; the app throws immediately if one is
# missing (see src/constants/env.ts, src/constants/ingest.ts, src/constants/provision.ts).
# Copy to .env and fill in. NOTE: EXPO_PUBLIC_* values are inlined into the client bundle
# and are therefore public — never put a server-side secret here.

# Supabase (Google OAuth).
# For the Playwright suite this MUST be exactly https://example.supabase.co: supabase-js
# derives its localStorage key from the project ref, and the test helper primes
# "sb-example-auth-token". A different URL silently breaks the primed session.
EXPO_PUBLIC_SUPABASE_URL=https://example.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend services (local defaults).
EXPO_PUBLIC_INGEST_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_PROVISION_API_URL=http://127.0.0.1:8002
EXPO_PUBLIC_INGEST_API_KEY=

# RevenueCat. Native only — the web build no-ops, so these may stay empty for web/E2E.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
